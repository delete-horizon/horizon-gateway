---
import type { Lang } from "../i18n/ui";
import { ui } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = (key: keyof (typeof ui)["ko"] | keyof (typeof ui)["en"]) => {
  // @ts-expect-error
  return ui[lang][key] ?? ui["ko"][key];
};

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout lang={lang}>
  <main data-lang={lang}>
    <!-- Background Glows — stronger, multi-layer -->
    <div class="glow-hero-primary"></div>
    <div class="glow-hero-secondary"></div>
    <div class="glow-hero-accent"></div>
    <div class="glow-backdrop" style="top: 1400px; left: -200px;"></div>
    <div class="glow-backdrop" style="top: 2600px; right: -200px; background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);"></div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Hero Section — Full-screen centered, big logo               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="hero-section">
      <!-- Animated Logo — big, edge-to-edge feel -->
      <div class="hero-visual">
        <img
          src={`${baseUrl}/logo-animated.svg`}
          alt="Horizon Gateway Logo"
          class="hero-animated-logo"
          loading="eager"
        />
      </div>

      <div class="hero-content">
        <div class="badge" id="hero-badge">{t('hero.badge')}</div>

        <h1 class="hero-title">
          {t('hero.title.pre')}<br/>
          {t('hero.title.post')}<img src={`${baseUrl}/logo-text.svg`} alt="Horizon Gateway" class="hero-logo-text" />
        </h1>

        <p class="hero-subtitle">
          {t('hero.subtitle')}
        </p>

        <div class="hero-actions">
          <a href="https://github.com/delete-horizon/horizon-gateway/releases" class="btn btn-primary btn-hero-download" id="primary-download-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <div class="btn-text-wrapper">
              <span id="primary-download-text">{t('hero.download.win')}</span>
              <span id="primary-download-subtext" class="btn-subtext">{t('hero.download.sub.win')}</span>
            </div>
          </a>

          <div class="cli-copy-box">
            <span class="cli-prefix">$</span>
            <code class="cli-code">hgc init --project</code>
            <button class="cli-copy-btn" id="copy-cli-btn" aria-label="Copy command">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="copy-icon">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="check-icon" style="display: none; stroke: var(--color-success);">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Features Section                                            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="features-section container" style="margin-top: 140px;">
      <div style="text-align: center; max-width: 620px; margin: 0 auto 50px;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">{t('features.title')}<span class="text-gradient">{t('features.title.accent')}</span></h2>
        <p style="color: var(--color-text-secondary);">{t('features.subtitle')}</p>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
          </div>
          <h3>{t('features.domain.title')}</h3>
          <p>{t('features.domain.desc')}</p>
          <div class="feature-visual">
            <div class="ping-signal">
              <span class="ring animate-ping"></span>
              <span class="signal-core"></span>
            </div>
            <span style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--color-success)">status: 200 OK (14ms)</span>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3>{t('features.proxy.title')}</h3>
          <p>{t('features.proxy.desc')}</p>
          <div class="feature-visual" style="flex-direction: column; align-items: stretch; gap: 8px;">
            <div class="route-map">
              <span class="route-node">prod-api.com</span>
              <span class="route-arrow">➔</span>
              <span class="route-node highlight">localhost:8080</span>
            </div>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-rose">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/><line x1="8" y1="9" x2="10" y2="9"/></svg>
          </div>
          <h3>{t('features.api.title')}</h3>
          <p>{t('features.api.desc')}</p>
          <div class="feature-visual font-mono" style="font-size: 0.8rem; background: rgba(0,0,0,0.35); border-radius: 8px; padding: 6px 12px; justify-content: flex-start; color: var(--color-accent);">
            <span>{'{ "mocked": true, "status": "success" }'}</span>
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-green">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <h3>{t('features.mobile.title')}</h3>
          <p>{t('features.mobile.desc')}</p>
          <div class="feature-visual" style="gap: 15px;">
            <span style="font-size: 0.8rem; border: 1px solid var(--border-color); padding: 4px 8px; border-radius: 6px;">{t('features.mobile.connect')}</span>
            <span class="route-arrow">↔</span>
            <span style="font-size: 0.8rem; border: 1px solid var(--color-success); padding: 4px 8px; border-radius: 6px; color: var(--color-success)">{t('features.mobile.tunnel')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature gallery — screenshots from the shipping app -->
    <section class="gallery-section container" style="margin-top: 160px;">
      <div style="text-align: center; max-width: 620px; margin: 0 auto 50px;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">{t('gallery.title')}<span class="text-gradient">{t('gallery.title.accent')}</span></h2>
        <p style="color: var(--color-text-secondary);">{t('gallery.subtitle')}</p>
      </div>

      <div class="gallery-tabs">
        <button class="gallery-tab active" data-tab="domains">{t('gallery.tab.domains')}</button>
        <button class="gallery-tab" data-tab="proxy">{t('gallery.tab.proxy')}</button>
        <button class="gallery-tab" data-tab="mocking">{t('gallery.tab.mocking')}</button>
        <button class="gallery-tab" data-tab="setup">{t('gallery.tab.setup')}</button>
        <button class="gallery-tab" data-tab="home">{t('gallery.tab.home')}</button>
      </div>

      <div class="gallery-panel-wrap">
        <div class="gallery-panel active glass-panel" data-panel="domains">
          <img src={`${baseUrl}/screenshots/gateway-domains.png`} alt={t('gallery.domains.label')} />
        </div>
        <div class="gallery-panel glass-panel" data-panel="proxy">
          <img src={`${baseUrl}/screenshots/gateway-proxy-connections.png`} alt={t('gallery.proxy.label')} />
        </div>
        <div class="gallery-panel glass-panel" data-panel="mocking">
          <img src={`${baseUrl}/screenshots/gateway-api-mocking.png`} alt={t('gallery.mocking.label')} />
        </div>
        <div class="gallery-panel glass-panel" data-panel="setup">
          <img src={`${baseUrl}/screenshots/gateway-proxy-setup.png`} alt={t('gallery.setup.label')} />
        </div>
        <div class="gallery-panel glass-panel" data-panel="home">
          <img src={`${baseUrl}/screenshots/gateway-home.png`} alt={t('gallery.home.label')} />
        </div>
      </div>
    </section>

    <!-- CLI — real hgc session -->
    <section class="terminal-section container" style="margin-top: 160px;">
      <div style="max-width: 500px;">
        <div class="badge" style="background: rgba(59, 130, 246, 0.1); color: var(--color-secondary); border-color: rgba(59, 130, 246, 0.2);">{t('terminal.badge')}</div>
        <h2 style="font-size: 2.3rem; margin: 15px 0;">{t('terminal.title')}<span class="text-gradient">{t('terminal.title.accent')}</span>{t('terminal.title.post')}</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 20px;">
          {t('terminal.desc')}
        </p>
      </div>

      <div class="terminal-shot glass-panel">
        <img src={`${baseUrl}/screenshots/gateway-hgc.png`} alt={t('terminal.shot.alt')} />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Technical Stack / Performance                               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="performance-section container" style="margin-top: 160px; background: radial-gradient(ellipse at center, rgba(62,200,255,0.04) 0%, rgba(255,138,43,0.03) 50%, transparent 70%); border-radius: 24px; padding: 70px 20px;">
      <div style="text-align: center; margin-bottom: 50px;">
        <h2 style="font-size: 2.3rem;">{t('perf.title')}<span class="text-gradient">{t('perf.title.accent')}</span></h2>
        <p style="color: var(--color-text-secondary); margin-top: 10px;">{t('perf.subtitle')}</p>
      </div>

      <div class="performance-grid">
        <div class="perf-card">
          <div class="perf-metric">~22MB</div>
          <div class="perf-label">{t('perf.installer.label')}</div>
          <div class="perf-progress-bar"><span style="width: 15%"></span></div>
          <p class="perf-desc">{t('perf.installer.desc')}</p>
        </div>
        <div class="perf-card">
          <div class="perf-metric">&lt; 50MB</div>
          <div class="perf-label">{t('perf.memory.label')}</div>
          <div class="perf-progress-bar"><span style="width: 25%"></span></div>
          <p class="perf-desc">{t('perf.memory.desc')}</p>
        </div>
        <div class="perf-card">
          <div class="perf-metric">0.1s</div>
          <div class="perf-label">{t('perf.startup.label')}</div>
          <div class="perf-progress-bar"><span style="width: 5%"></span></div>
          <p class="perf-desc">{t('perf.startup.desc')}</p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CTA Section                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="cta-section container" style="margin: 160px auto 100px; text-align: center; position: relative;">
      <div class="glass-panel cta-panel">
        <div class="cta-glow-cyan"></div>
        <div class="cta-glow-orange"></div>
        <h2 style="font-size: 2.8rem; margin-bottom: 1.5rem; position:relative; z-index:1;">{t('cta.title')}<span class="text-gradient">{t('cta.title.accent')}</span>{t('cta.title.post')}</h2>
        <p style="color: var(--color-text-secondary); max-width: 600px; margin: 0 auto 40px; font-size: 1.1rem; position:relative; z-index:1;">
          {t('cta.desc')}
        </p>
        <div style="display: flex; justify-content: center; gap: 20px; position:relative; z-index:1;">
          <a href="https://github.com/delete-horizon/horizon-gateway/releases" class="btn btn-primary" style="padding: 1rem 2rem;">
            {t('cta.btn')}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<!-- Client scripts for interactivity -->
<script>
  // Read target language from DOM data attribute
  const lang = document.querySelector('main')?.getAttribute('data-lang') || 'ko';

  // 1. OS Detection Logic for Download Button
  const userAgent = navigator.userAgent.toLowerCase();
  const downloadBtn = document.getElementById('primary-download-btn') as HTMLAnchorElement | null;
  const downloadText = document.getElementById('primary-download-text');
  const downloadSubText = document.getElementById('primary-download-subtext');
  const heroBadge = document.getElementById('hero-badge');
  const releasesUrl = 'https://github.com/delete-horizon/horizon-gateway/releases/latest';

  if (downloadBtn && downloadText && downloadSubText) {
    let currentVer = 'v2.8.14';
    const updateDownloadInfo = (ver: string) => {
      if (heroBadge) {
        heroBadge.textContent = lang === 'ko' ? `${ver} 릴리즈` : `${ver} Release`;
      }
      downloadBtn.href = releasesUrl;
      if (userAgent.includes('win')) {
        downloadText.textContent = lang === 'ko' ? 'Windows용 다운로드' : 'Download for Windows';
        downloadSubText.textContent = `NSIS .exe (${ver})`;
      } else if (userAgent.includes('mac')) {
        downloadText.textContent = lang === 'ko' ? 'macOS용 다운로드' : 'Download for macOS';
        downloadSubText.textContent = `.dmg · Apple Silicon & Intel (${ver})`;
      } else {
        downloadText.textContent = lang === 'ko' ? 'GitHub 릴리즈 페이지' : 'GitHub Releases Page';
        downloadSubText.textContent = lang === 'ko' ? '모든 OS 설치파일 목록' : 'All Operating Systems';
      }
    };
    updateDownloadInfo(currentVer);

    fetch('https://api.github.com/repos/delete-horizon/horizon-gateway/releases/latest')
      .then((res) => res.json())
      .then((data) => {
        if (data && data.tag_name) {
          updateDownloadInfo(data.tag_name);
        }
      })
      .catch(() => {});
  }

  // 2. CLI Command Copy Functionality
  const copyBtn = document.getElementById('copy-cli-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  if (copyBtn && copyIcon && checkIcon) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('hgc init --project');
        copyIcon.style.display = 'none';
        checkIcon.style.display = 'inline';
        setTimeout(() => {
          copyIcon.style.display = 'inline';
          checkIcon.style.display = 'none';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text: ', err);
      }
    });
  }

  // 2. Gallery Tab Logic
  const galleryTabs = document.querySelectorAll('.gallery-tab');
  const galleryPanels = document.querySelectorAll('.gallery-panel');

  galleryTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetTab = tab.getAttribute('data-tab');

      galleryTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      galleryPanels.forEach(panel => {
        if (panel.getAttribute('data-panel') === targetTab) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  /* ─── Layout ─── */
  main {
    padding-top: 70px;
    position: relative;
    overflow: hidden;
  }

  /* ─── Multi-layer Hero Glows ─── */
  .glow-hero-primary {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(168, 85, 247, 0.18) 0%, rgba(168, 85, 247, 0.06) 40%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .glow-hero-secondary {
    position: absolute;
    top: 50px;
    left: 50%;
    transform: translateX(-40%);
    width: 800px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(59, 130, 246, 0.12) 0%, transparent 70%);
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  .glow-hero-accent {
    position: absolute;
    top: 100px;
    left: 50%;
    transform: translateX(-60%);
    width: 600px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(236, 72, 153, 0.08) 0%, transparent 70%);
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }

  /* ─── Badge ─── */
  .badge {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-primary);
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(168, 85, 247, 0.25);
    display: inline-block;
    backdrop-filter: blur(8px);
  }

  /* ─── Hero ─── */
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    min-height: calc(100vh - 70px);
    justify-content: center;
    position: relative;
    z-index: 1;
    padding: 0 2rem 60px;
  }

  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    width: 100%;
    margin-bottom: -2rem;
  }

  .hero-animated-logo {
    width: 100%;
    max-width: 960px;
    height: auto;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 0 80px rgba(168, 85, 247, 0.2));
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
    position: relative;
  }

  .hero-title {
    font-size: 3.6rem;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    word-break: keep-all;
    text-wrap: balance;
  }

  .hero-logo-text {
    height: 3.8rem;
    width: auto;
    vertical-align: middle;
    display: inline-block;
    margin-top: -0.25rem;
    filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.25));
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    max-width: 640px;
    line-height: 1.75;
    word-break: keep-all;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
    justify-content: center;
  }

  .btn-hero-download {
    padding: 0.9rem 1.8rem;
    height: 54px;
  }

  .btn-text-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .btn-subtext {
    font-size: 0.72rem;
    font-weight: 400;
    opacity: 0.8;
  }

  /* CLI Copy Box */
  .cli-copy-box {
    display: flex;
    align-items: center;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(168, 85, 247, 0.15);
    padding: 0 1.2rem;
    border-radius: 10px;
    height: 54px;
    font-family: var(--font-mono);
    gap: 0.8rem;
    font-size: 0.9rem;
    max-width: 100%;
    backdrop-filter: blur(8px);
  }

  .cli-prefix {
    color: var(--color-primary);
    font-weight: 600;
    user-select: none;
  }

  .cli-code {
    color: var(--color-text-primary);
  }

  .cli-copy-btn {
    background: transparent;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0.4rem;
    border-radius: 6px;
    transition: var(--transition-fast);
  }

  .cli-copy-btn:hover {
    color: var(--color-primary);
    background: rgba(168, 85, 247, 0.1);
  }

  /* ─── Feature Cards ─── */
  .feature-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .feature-icon.icon-violet {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-primary);
  }

  .feature-icon.icon-blue {
    background: rgba(59, 130, 246, 0.12);
    color: var(--color-secondary);
  }

  .feature-icon.icon-rose {
    background: rgba(236, 72, 153, 0.12);
    color: var(--color-accent);
  }

  .feature-icon.icon-green {
    background: rgba(16, 185, 129, 0.12);
    color: var(--color-success);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
    line-height: 1.65;
  }

  .feature-visual {
    width: 100%;
    height: 60px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
