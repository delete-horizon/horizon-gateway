{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "horizon-gateway",
  "version": "2.8.4",
  "identifier": "com.lurain.horizon-gateway",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/build-serve-sidecar.mjs",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Horizon Gateway",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        },
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "icon.ico",
      "resources/windivert/WinDivert.dll": "WinDivert.dll",
      "resources/windivert/WinDivert64.sys": "WinDivert64.sys"
    },
    "externalBin": [
      "binaries/horizon-gateway-serve",
      "binaries/hgc"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./hooks.nsh",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQzYwMjMwNzk3RjZFRUEKUldUcWJuOTVNQUxHMHdvRGJTdFI5d3VNUmJ6TWZ3QnVtODNEb3dSTGE4dmNXWi85L3BwRGRiaEIK",
      "endpoints": [
        "https://github.com/delete-horizon/horizon-gateway/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "horizon-gateway"
        ]
      }
    }
  }
}
