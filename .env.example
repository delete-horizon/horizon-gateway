# Horizon Gateway — env template (copy to `.env`)

# --- Cloud (release / CI bake-in) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Local Supabase (recommended for `pnpm tauri` / root `pnpm dev:gateway:tauri`) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Anon key: leave empty; scripts/ensure-supabase-local.mjs writes .env.supabase.local

VITE_DEV_LOCAL_EMAIL=dev@localhost
VITE_DEV_LOCAL_PASSWORD=dev-password-change-me
VITE_DEV_LOCAL_DISPLAY_NAME=Local Dev
VITE_DEV_LOCAL_GITHUB_LOGIN=local-dev
VITE_DEV_LOCAL_TEAM_ENTITLEMENT=unlimited

# Optional product flags
# VITE_ENABLE_PAID_CHECKOUT=false
# VITE_LEMON_SQUEEZY_CHECKOUT_URL=
